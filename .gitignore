# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.enc
# the ENCRYPTED vault is meant to be committed (see SECURITY.md)
!state/vault.enc
.passphrase
client_secret*.json
*credentials*.json
.git-credentials
*.pem
*.key
token*.json
# runtime data
*.log
state/*.tmp
queue/posts/*.tmp
# media and outputs (media travels through GitHub releases, never through git)
*.mp4
*.mov
*.wav
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png
!docs/**/*.jpg
outputs/
films/
# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
